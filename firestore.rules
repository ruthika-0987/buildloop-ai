rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Material Batches collection
    match /batches/{batchId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(batchId);
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Demands collection
    match /demands/{demandId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(demandId);
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Orders collection
    match /orders/{orderId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId);
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Sensor Readings collection
    match /sensorReadings/{readingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(readingId);
      allow update: if false;
      allow delete: if false;
    }
  }
}
